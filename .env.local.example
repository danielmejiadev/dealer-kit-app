# Copy to .env.local (gitignored, never committed) and fill in real values.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never reference this with NEXT_PUBLIC_ or use it in a
# Client Component — it bypasses Row-Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider — server-only, used from services/ through a Route Handler.
# Never reference this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
